{
  "name": "@cf-session-hub/core",
  "version": "0.1.0",
  "private": true,
  "description": "CF Session Hub core service: REST API, CF home scanner, SSO login orchestration and keep-alive scheduler",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./bin": "./dist/src/bin/cf-session-hub.js"
  },
  "bin": {
    "cf-session-hub": "./dist/src/bin/cf-session-hub.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "start": "node dist/src/bin/cf-session-hub.js"
  },
  "dependencies": {
    "@cf-session-hub/web": "0.1.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
