#!/usr/bin/env bash
# Wrapper that starts the CF Session Hub core service in the foreground.
set -euo pipefail

target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
  dir="$(cd -P "$(dirname "$target")" && pwd)"
  target="$(readlink "$target")"
  [[ "$target" != /* ]] && target="$dir/$target"
done
root="$(cd -P "$(dirname "$target")/.." && pwd)"

entry="$root/packages/core/dist/src/bin/cf-session-hub.js"
if [ ! -f "$entry" ]; then
  echo "CF Session Hub is not built yet. Run: (cd $root && npm install && npm run build)" >&2
  exit 1
fi
exec node "$entry" "$@"
