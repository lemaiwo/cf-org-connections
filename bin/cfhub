#!/usr/bin/env bash
# Wrapper so `cfhub` works from anywhere: symlink this file into your PATH.
# It resolves through symlinks to find the repository it lives in.
set -euo pipefail

target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
  dir="$(cd -P "$(dirname "$target")" && pwd)"
  target="$(readlink "$target")"
  [[ "$target" != /* ]] && target="$dir/$target"
done
root="$(cd -P "$(dirname "$target")/.." && pwd)"

entry="$root/packages/cli/dist/src/index.js"
if [ ! -f "$entry" ]; then
  echo "cfhub is not built yet. Run: (cd $root && npm install && npm run build)" >&2
  exit 1
fi
exec node "$entry" "$@"
